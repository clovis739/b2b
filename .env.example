# Test mode never sends email. The private mailbox appears in account settings.
MARKETPLACE_TEST_MODE=true
# Explicit administrator allowlist; registering a supplier does not grant admin access.
ADMIN_EMAILS=moderator@example.test
# DATABASE_PATH=data/marketplace.sqlite
# For a future live installation: turn test mode off and configure these values.
# APP_ORIGIN=https://your-domain.example
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
